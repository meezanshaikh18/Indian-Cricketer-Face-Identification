# Python virtual environments (including local project-specific environments)
venv/
venv*/
.venv/
.venv*/
.venv312/
env/
env*/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Local environment files and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Downloaded datasets, processed face images, and generated embeddings
/data/*
!/data/.gitkeep

# Trained classifiers and generated model artifacts
/models/*
!/models/.gitkeep
*.joblib
*.pkl
*.pickle
*.pt
*.pth

# Generated evaluation reports and plots
/reports/*
!/reports/.gitkeep

# Build and packaging artifacts
build/
dist/
*.egg-info/

# IDE and editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files and logs
*.log
*.tmp
*.bak
~$*
